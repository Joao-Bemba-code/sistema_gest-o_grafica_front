{
  "name": "sigraf-desktop",
  "version": "1.0.0",
  "description": "SIGRAF - Sistema de Gestão para Indústria Gráfica (aplicação desktop)",
  "main": "main.js",
  "author": "CENFFOR",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "sync": "node scripts/sync.js",
    "start": "electron .",
    "dev": "electron .",
    "rebuild": "electron-rebuild -f -w sqlite3",
    "dist": "node scripts/sync.js && electron-builder --win nsis"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.2",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.2.0",
    "mysql2": "^3.23.1",
    "sequelize": "^6.37.8",
    "sqlite3": "^6.0.1",
    "xss": "^1.0.15"
  },
  "devDependencies": {
    "electron": "43.2.0",
    "electron-builder": "^24.13.3",
    "electron-rebuild": "^3.2.9"
  },
  "build": {
    "appId": "com.cenffor.sigraf",
    "productName": "SIGRAF",
    "npmRebuild": false,
    "directories": {
      "output": "dist",
      "buildResources": "recursos"
    },
    "files": [
      "main.js",
      "preload.js",
      "server.js",
      "offline/**/*",
      "package.json",
      "recursos/**",
      "backend/**/*",
      "web/**/*"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
